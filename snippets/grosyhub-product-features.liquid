{%- liquid
  assign show_trust = settings.show_trust_cards | default: true
  unless show_trust
    assign show_trust = false
  endunless

  assign t1 = settings.trust_1_title | default: settings.trust_shipping | default: 'Free Shipping'
  assign s1 = settings.trust_1_text | default: 'On all orders'
  assign t2 = settings.trust_2_title | default: settings.trust_returns | default: 'Easy Returns'
  assign s2 = settings.trust_2_text | default: '7 days hassle-free'
  assign t3 = settings.trust_3_title | default: 'Secure Payments'
  assign s3 = settings.trust_3_text | default: '100% safe checkout'
  assign t4 = settings.trust_4_title | default: 'Premium Quality'
  assign s4 = settings.trust_4_text | default: 'Handpicked essentials'
-%}

{%- if show_trust -%}
  <div class="gh-pdp-trust" style="--gh-pdp-brand: {{ brand_color | default: '#b89774' }};">
    <ul class="gh-pdp-trust__grid" role="list">
      <li class="gh-pdp-trust__card">
        <span class="gh-pdp-trust__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M1 4h15v10H6l-4 4V4zm17 2h4l2 4v8h-6V6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="gh-pdp-trust__text">
          <strong>{{ t1 }}</strong>
          {%- if s1 != blank -%}<span>{{ s1 }}</span>{%- endif -%}
        </div>
      </li>
      <li class="gh-pdp-trust__card">
        <span class="gh-pdp-trust__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M4 7h12l2 4v6H6l-2-4V7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="gh-pdp-trust__text">
          <strong>{{ t2 }}</strong>
          {%- if s2 != blank -%}<span>{{ s2 }}</span>{%- endif -%}
        </div>
      </li>
      <li class="gh-pdp-trust__card">
        <span class="gh-pdp-trust__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 3l7 3v5c0 4.5-3.2 8.4-7 9-3.8-.6-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M9 12h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
        <div class="gh-pdp-trust__text">
          <strong>{{ t3 }}</strong>
          {%- if s3 != blank -%}<span>{{ s3 }}</span>{%- endif -%}
        </div>
      </li>
      <li class="gh-pdp-trust__card">
        <span class="gh-pdp-trust__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
            <path d="M12 3l2.2 4.5 5 .7-3.6 3.5.9 5L12 15.8 7.4 17l.9-5L4.8 8.2l5-.7L12 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="gh-pdp-trust__text">
          <strong>{{ t4 }}</strong>
          {%- if s4 != blank -%}<span>{{ s4 }}</span>{%- endif -%}
        </div>
      </li>
    </ul>
  </div>
{%- endif -%}
