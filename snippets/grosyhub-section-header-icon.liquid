{%- comment -%}
  Section header icon. icon: reels | category | star | trending | products
{%- endcomment -%}
{%- case icon -%}
  {%- when 'category' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="8" height="8" rx="2" fill="currentColor"/>
      <rect x="13" y="3" width="8" height="8" rx="2" fill="currentColor"/>
      <rect x="3" y="13" width="8" height="8" rx="2" fill="currentColor"/>
      <rect x="13" y="13" width="8" height="8" rx="2" fill="currentColor"/>
    </svg>
  {%- when 'trending' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 16l6-10 4 6 6-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M17 4h3v3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'products' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 8h15l-1.5 9H7.5L6 8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
  {%- when 'star' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l2.2 4.5 4.9.7-3.5 3.4.8 4.9L12 13.3 7.6 15.5l.8-4.9-3.5-3.4 4.9-.7L12 2z"/>
    </svg>
  {%- when 'reels' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="5" width="14" height="14" rx="3" stroke="currentColor" stroke-width="1.6"/>
      <path d="M17 8l4-2v12l-4-2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l2.2 4.5 4.9.7-3.5 3.4.8 4.9L12 13.3 7.6 15.5l.8-4.9-3.5-3.4 4.9-.7L12 2z"/>
    </svg>
{%- endcase -%}
