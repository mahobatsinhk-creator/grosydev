{%- liquid
  assign show_reels = settings.show_product_reels | default: true
  unless show_reels
    assign show_reels = false
  endunless

  assign brand_color = brand_color | default: settings.brand_color | default: '#b89774'
  assign reel_blocks_count = 0
  for block in section.blocks
    if block.type == 'reel'
      assign reel_blocks_count = reel_blocks_count | plus: 1
    endif
  endfor
  assign has_reel_blocks = false
  if reel_blocks_count > 0
    assign has_reel_blocks = true
    assign reel_count = reel_blocks_count
  endif

  unless has_reel_blocks
    assign reel_count = 0
    for media in product.media
      if media.media_type == 'video'
        assign reel_count = reel_count | plus: 1
      endif
    endfor
  endunless

  assign fallback_collection = settings.reels_collection
  if reel_count == 0 and fallback_collection != blank
    assign products = fallback_collection.products
    assign reel_count = products.size
    if settings.reels_max > 0 and reel_count > settings.reels_max
      assign reel_count = settings.reels_max
    endif
    assign use_collection = true
  endif
-%}

{%- if show_reels and reel_count > 0 -%}
  {{ 'grosyhub-pdp-reels.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'grosyhub-pdp-reels.js' | asset_url }}" defer></script>

  <div
    class="gh-pdp-reels"
    data-gh-pdp-reels
    style="--gh-pdp-reel-brand: {{ brand_color }};"
  >
    {%- if settings.reels_heading != blank -%}
      <h2 class="gh-pdp-reels__heading">{{ settings.reels_heading }}</h2>
    {%- endif -%}

    <div class="gh-pdp-reels__carousel" data-gh-pdp-reels-carousel>
      <div class="gh-pdp-reels__track-wrap">
        <button type="button" class="gh-pdp-reels__arrow gh-pdp-reels__arrow--prev" data-gh-pdp-reels-prev aria-label="Previous">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="gh-pdp-reels__arrow gh-pdp-reels__arrow--next" data-gh-pdp-reels-next aria-label="Next">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="gh-pdp-reels__track" data-gh-pdp-reels-track>
          {%- assign reel_index = 0 -%}
          {%- if has_reel_blocks -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'reel' -%}
                <div class="gh-pdp-reels__slide" data-gh-pdp-reels-slide>
                  {% render 'grosyhub-pdp-reel-card',
                    block: block,
                    product: product,
                    reel_index: reel_index,
                    brand_color: brand_color
                  %}
                </div>
                {%- assign reel_index = reel_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- elsif use_collection -%}
            {%- assign shown = 0 -%}
            {%- assign max_reels = settings.reels_max | default: 8 -%}
            {%- for coll_product in products -%}
              {%- if shown >= max_reels -%}{%- break -%}{%- endif -%}
              <div class="gh-pdp-reels__slide" data-gh-pdp-reels-slide>
                {% render 'grosyhub-pdp-reel-card',
                  product: coll_product,
                  reel_index: reel_index,
                  brand_color: brand_color
                %}
              </div>
              {%- assign reel_index = reel_index | plus: 1 -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endfor -%}
          {%- else -%}
            {%- for media in product.media -%}
              {%- if media.media_type == 'video' -%}
                <div class="gh-pdp-reels__slide" data-gh-pdp-reels-slide>
                  {% render 'grosyhub-pdp-reel-card',
                    product: product,
                    video: media,
                    reel_index: reel_index,
                    brand_color: brand_color
                  %}
                </div>
                {%- assign reel_index = reel_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="gh-pdp-reels-modal" data-gh-pdp-reels-modal hidden aria-hidden="true">
      <div class="gh-pdp-reels-modal__overlay" data-gh-pdp-reels-close></div>

      <button type="button" class="gh-pdp-reels-modal__close" data-gh-pdp-reels-close aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <button type="button" class="gh-pdp-reels-modal__nav gh-pdp-reels-modal__nav--prev" data-gh-pdp-reels-modal-prev aria-label="Previous reel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <button type="button" class="gh-pdp-reels-modal__nav gh-pdp-reels-modal__nav--next" data-gh-pdp-reels-modal-next aria-label="Next reel">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>

      <div class="gh-pdp-reels-modal__dialog" role="dialog" aria-modal="true" aria-label="Product reel">
        {%- assign panel_index = 0 -%}
        {%- if has_reel_blocks -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'reel' -%}
              {%- liquid
                assign reel_product = block.settings.product | default: product
                assign reel_video = block.settings.video
                if reel_video == blank
                  for media in reel_product.media
                    if media.media_type == 'video'
                      assign reel_video = media
                      break
                    endif
                  endfor
                endif
                assign variant = reel_product.selected_or_first_available_variant
                assign desc_plain = reel_product.description | strip_html | strip
              -%}
              <div class="gh-pdp-reels-modal__panel{% if panel_index == 0 %} is-active{% endif %}" data-gh-pdp-reels-panel="{{ panel_index }}"{% unless panel_index == 0 %} hidden{% endunless %}>
                <div class="gh-pdp-reels-modal__video-col">
                  {%- if reel_video != blank -%}
                    <div class="gh-pdp-reels-modal__video-wrap">
                      {{
                        reel_video
                        | video_tag:
                          class: 'gh-pdp-reels-modal__video',
                          autoplay: false,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata',
                          image_size: '900x'
                      }}
                      <button type="button" class="gh-pdp-reels-modal__mute" data-gh-pdp-reels-mute aria-label="Unmute video" aria-pressed="true">
                        <svg class="gh-pdp-reels-modal__mute-on" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5zm8.59 3.41L17.17 7l-4.24 4.24 4.24 4.24 2.42-2.42L15.41 12l4.18-4.18z" fill="currentColor"/></svg>
                        <svg class="gh-pdp-reels-modal__mute-off" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" fill="currentColor"/></svg>
                      </button>
                    </div>
                  {%- elsif reel_product.featured_media != blank -%}
                    {{
                      reel_product.featured_media
                      | image_url: width: 900
                      | image_tag: class: 'gh-pdp-reels-modal__fallback-img', loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 900', alt: reel_product.title
                    }}
                  {%- endif -%}
                  {%- if block.settings.caption_top != blank -%}
                    <p class="gh-pdp-reels-modal__caption">{{ block.settings.caption_top }}</p>
                  {%- endif -%}
                </div>
                <div class="gh-pdp-reels-modal__info-col">
                  {%- if reel_product.featured_media != blank -%}
                    <div class="gh-pdp-reels-modal__hero-img">
                      {{
                        reel_product.featured_media
                        | image_url: width: 600
                        | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '280px', alt: reel_product.title
                      }}
                    </div>
                  {%- endif -%}
                  <h3 class="gh-pdp-reels-modal__title">{{ reel_product.title }}</h3>
                  <div class="gh-pdp-reels-modal__price">
                    <span class="gh-pdp-reels-modal__price-current">{{ variant.price | money }}</span>
                    {%- if variant.compare_at_price > variant.price -%}
                      <span class="gh-pdp-reels-modal__price-compare">{{ variant.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  {%- if desc_plain != blank -%}
                    <p class="gh-pdp-reels-modal__desc">{{ desc_plain | truncate: 160 }}</p>
                  {%- endif -%}
                  <div class="gh-pdp-reels-modal__actions">
                    <a href="{{ reel_product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--ghost">More info</a>
                    {%- if variant.available -%}
                      <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" data-gh-pdp-reels-add-cart="{{ variant.id }}">Add to cart</button>
                    {%- else -%}
                      <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" disabled>Sold out</button>
                    {%- endif -%}
                    <a href="{{ reel_product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--buy">Buy It Now</a>
                  </div>
                </div>
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif use_collection -%}
          {%- assign shown = 0 -%}
          {%- assign max_reels = settings.reels_max | default: 8 -%}
          {%- for coll_product in products -%}
            {%- if shown >= max_reels -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign reel_video = nil
              for media in coll_product.media
                if media.media_type == 'video'
                  assign reel_video = media
                  break
                endif
              endfor
              assign variant = coll_product.selected_or_first_available_variant
              assign desc_plain = coll_product.description | strip_html | strip
            -%}
            <div class="gh-pdp-reels-modal__panel{% if panel_index == 0 %} is-active{% endif %}" data-gh-pdp-reels-panel="{{ panel_index }}" hidden>
              <div class="gh-pdp-reels-modal__video-col">
                {%- if reel_video != blank -%}
                  <div class="gh-pdp-reels-modal__video-wrap">
                    {{
                      reel_video
                      | video_tag:
                        class: 'gh-pdp-reels-modal__video',
                        autoplay: false,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        preload: 'metadata',
                        image_size: '900x'
                    }}
                    <button type="button" class="gh-pdp-reels-modal__mute" data-gh-pdp-reels-mute aria-label="Unmute video" aria-pressed="true">
                      <svg class="gh-pdp-reels-modal__mute-on" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5zm8.59 3.41L17.17 7l-4.24 4.24 4.24 4.24 2.42-2.42L15.41 12l4.18-4.18z" fill="currentColor"/></svg>
                      <svg class="gh-pdp-reels-modal__mute-off" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" fill="currentColor"/></svg>
                    </button>
                  </div>
                {%- elsif coll_product.featured_media != blank -%}
                  {{ coll_product.featured_media | image_url: width: 900 | image_tag: class: 'gh-pdp-reels-modal__fallback-img', loading: 'lazy', alt: coll_product.title }}
                {%- endif -%}
              </div>
              <div class="gh-pdp-reels-modal__info-col">
                {%- if coll_product.featured_media != blank -%}
                  <div class="gh-pdp-reels-modal__hero-img">
                    {{ coll_product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '280px', alt: coll_product.title }}
                  </div>
                {%- endif -%}
                <h3 class="gh-pdp-reels-modal__title">{{ coll_product.title }}</h3>
                <div class="gh-pdp-reels-modal__price">
                  <span class="gh-pdp-reels-modal__price-current">{{ variant.price | money }}</span>
                  {%- if variant.compare_at_price > variant.price -%}
                    <span class="gh-pdp-reels-modal__price-compare">{{ variant.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
                {%- if desc_plain != blank -%}
                  <p class="gh-pdp-reels-modal__desc">{{ desc_plain | truncate: 160 }}</p>
                {%- endif -%}
                <div class="gh-pdp-reels-modal__actions">
                  <a href="{{ coll_product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--ghost">More info</a>
                  {%- if variant.available -%}
                    <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" data-gh-pdp-reels-add-cart="{{ variant.id }}">Add to cart</button>
                  {%- else -%}
                    <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" disabled>Sold out</button>
                  {%- endif -%}
                  <a href="{{ coll_product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--buy">Buy It Now</a>
                </div>
              </div>
            </div>
            {%- assign panel_index = panel_index | plus: 1 -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        {%- else -%}
          {%- for media in product.media -%}
            {%- if media.media_type == 'video' -%}
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign desc_plain = product.description | strip_html | strip
              -%}
              <div class="gh-pdp-reels-modal__panel{% if panel_index == 0 %} is-active{% endif %}" data-gh-pdp-reels-panel="{{ panel_index }}"{% unless panel_index == 0 %} hidden{% endunless %}>
                <div class="gh-pdp-reels-modal__video-col">
                  <div class="gh-pdp-reels-modal__video-wrap">
                    {{
                      media
                      | video_tag:
                        class: 'gh-pdp-reels-modal__video',
                        autoplay: false,
                        loop: true,
                        muted: true,
                        controls: false,
                        playsinline: true,
                        preload: 'metadata',
                        image_size: '900x'
                    }}
                    <button type="button" class="gh-pdp-reels-modal__mute" data-gh-pdp-reels-mute aria-label="Unmute video" aria-pressed="true">
                      <svg class="gh-pdp-reels-modal__mute-on" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5zm8.59 3.41L17.17 7l-4.24 4.24 4.24 4.24 2.42-2.42L15.41 12l4.18-4.18z" fill="currentColor"/></svg>
                      <svg class="gh-pdp-reels-modal__mute-off" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" fill="currentColor"/></svg>
                    </button>
                  </div>
                </div>
                <div class="gh-pdp-reels-modal__info-col">
                  {%- if product.featured_media != blank -%}
                    <div class="gh-pdp-reels-modal__hero-img">
                      {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '280px', alt: product.title }}
                    </div>
                  {%- endif -%}
                  <h3 class="gh-pdp-reels-modal__title">{{ product.title }}</h3>
                  <div class="gh-pdp-reels-modal__price">
                    <span class="gh-pdp-reels-modal__price-current">{{ variant.price | money }}</span>
                    {%- if variant.compare_at_price > variant.price -%}
                      <span class="gh-pdp-reels-modal__price-compare">{{ variant.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  {%- if desc_plain != blank -%}
                    <p class="gh-pdp-reels-modal__desc">{{ desc_plain | truncate: 160 }}</p>
                  {%- endif -%}
                  <div class="gh-pdp-reels-modal__actions">
                    <a href="{{ product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--ghost">More info</a>
                    {%- if variant.available -%}
                      <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" data-gh-pdp-reels-add-cart="{{ variant.id }}">Add to cart</button>
                    {%- else -%}
                      <button type="button" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--primary" disabled>Sold out</button>
                    {%- endif -%}
                    <a href="{{ product.url }}" class="gh-pdp-reels-modal__btn gh-pdp-reels-modal__btn--buy">Buy It Now</a>
                  </div>
                </div>
              </div>
              {%- assign panel_index = panel_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
