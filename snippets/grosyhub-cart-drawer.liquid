{%- liquid
  assign free_threshold = section.settings.free_shipping_threshold | default: 499 | times: 100
-%}
<aside
  id="gh-cart-drawer"
  class="gh-drawer gh-cart-drawer"
  data-gh-cart-drawer
  data-free-shipping-threshold="{{ free_threshold }}"
  hidden
  aria-label="Cart"
>
  <div class="gh-drawer__backdrop" data-gh-cart-close tabindex="-1" aria-hidden="true"></div>
  <div class="gh-drawer__panel gh-cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="gh-cart-drawer-title">
    <div class="gh-drawer__head gh-cart-drawer__head">
      <h2 id="gh-cart-drawer-title" class="gh-drawer__title" data-gh-cart-title>
        {{ section.settings.cart_drawer_heading | default: 'Your Cart' }}
      </h2>
      <button type="button" class="gh-drawer__close" data-gh-cart-close aria-label="Close cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="gh-cart-drawer__scroll" data-gh-cart-scroll>
      <div class="gh-cart-drawer__shipping" data-gh-cart-shipping-wrap hidden>
        <p class="gh-cart-drawer__shipping-text" data-gh-cart-shipping-text></p>
        <div class="gh-cart-drawer__shipping-bar-row">
          <div class="gh-cart-drawer__shipping-bar" aria-hidden="true">
            <span class="gh-cart-drawer__shipping-fill" data-gh-cart-shipping-fill></span>
          </div>
          <span class="gh-cart-drawer__shipping-goal" data-gh-cart-threshold-label>
            ₹{{ section.settings.free_shipping_threshold | default: 499 }}
          </span>
        </div>
      </div>

      <div class="gh-drawer__body gh-cart-drawer__body" data-gh-cart-body>
        <p class="gh-cart-drawer__empty" data-gh-cart-empty hidden>
          {{ section.settings.cart_empty_text | default: 'Your cart is empty.' }}
        </p>
        <ul class="gh-cart-drawer__list" data-gh-cart-list role="list"></ul>
      </div>
    </div>

    <div class="gh-cart-drawer__summary" data-gh-cart-summary hidden>
      <div class="gh-cart-drawer__summary-rows">
        <div class="gh-cart-drawer__summary-row">
          <span>Subtotal</span>
          <span data-gh-cart-subtotal></span>
        </div>
        <div class="gh-cart-drawer__summary-row">
          <span>Shipping</span>
          <span class="gh-cart-drawer__free" data-gh-cart-shipping-label>FREE</span>
        </div>
      </div>

      <div class="gh-cart-drawer__save-banner" data-gh-cart-save-row hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 21s-7.5-4.7-9.8-9.4C.4 8.2 2.6 4 6.4 4c2 0 3.2 1.2 3.6 1.8C10.4 5.2 11.6 4 13.6 4c3.8 0 6 4.2 4.2 7.6C19.5 16.3 12 21 12 21z" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        <span>You Save <strong data-gh-cart-save></strong></span>
      </div>

      <div class="gh-cart-drawer__total-row">
        <div>
          <strong>Total</strong>
          <span class="gh-cart-drawer__tax-note">(incl. of all taxes)</span>
        </div>
        <strong data-gh-cart-total></strong>
      </div>

      <div class="gh-cart-drawer__checkout-wrap">
        <div class="shiprocket-headless" data-type="mini-cart"></div>
      </div>

      <a href="{{ routes.cart_url }}" class="gh-cart-drawer__view-cart">
        {{ section.settings.cart_view_label | default: 'View Cart' }}
      </a>

      <ul class="gh-cart-drawer__trust" role="list">
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 12a8 8 0 0116 0v4H4v-4z" stroke="currentColor" stroke-width="1.4"/>
            <path d="M8 16v2h8v-2" stroke="currentColor" stroke-width="1.4"/>
          </svg>
          <span>{{ section.settings.cart_trust_1 | default: '7 Days Easy Returns' }}</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 8h13v9H3V8zm13 2h3l2 4v3h-5V6z" stroke="currentColor" stroke-width="1.4"/>
          </svg>
          <span>{{ section.settings.cart_trust_2 | default: 'Secure Payments' }}</span>
        </li>
        <li>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3l2.2 4.5 5 .7-3.6 3.5.9 5L12 14.8 7.5 16.7l.9-5L4.8 8.2l5-.7L12 3z" stroke="currentColor" stroke-width="1.4"/>
          </svg>
          <span>{{ section.settings.cart_trust_3 | default: 'Premium Quality' }}</span>
        </li>
      </ul>
    </div>
  </div>
</aside>
