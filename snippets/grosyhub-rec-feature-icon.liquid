{%- comment -%}
  Renders a feature icon for recommendation cards.
  icon: foldable | space | multipurpose | adjustable | antiskid | nodrill
{%- endcomment -%}

{%- case icon -%}
  {%- when 'foldable' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M8 4h8v4H8V4zm0 6h8v4H8v-4zm0 6h8v4H8v-4z" stroke="currentColor" stroke-width="1.4"/>
      <path d="M6 6h12M6 12h12M6 18h12" stroke="currentColor" stroke-width="1.4"/>
    </svg>
  {%- when 'space' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="5" y="6" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M9 10h6M9 14h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  {%- when 'multipurpose' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="5" width="16" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
      <rect x="6" y="10" width="12" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
      <rect x="8" y="15" width="8" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/>
    </svg>
  {%- when 'adjustable' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M7 7h10v10H7V7z" stroke="currentColor" stroke-width="1.3"/>
      <path d="M4 4h3v3H4V4zm13 0h3v3h-3V4zM4 17h3v3H4v-3zm13 0h3v3h-3v-3z" stroke="currentColor" stroke-width="1.3"/>
      <path d="M10 12h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="10" cy="12" r="1" fill="currentColor"/>
      <circle cx="14" cy="12" r="1" fill="currentColor"/>
    </svg>
  {%- when 'antiskid' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M8 14c2-3 4-4 8-4 2 0 3 1 4 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M12 6v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="12" cy="5" r="1.5" stroke="currentColor" stroke-width="1.2"/>
      <path d="M6 16h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  {%- when 'nodrill' -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M10 4v6l-2 2v2h8v-2l-2-2V4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M4 20l16-12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg class="gh-rec-card__feature-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="7" stroke="currentColor" stroke-width="1.4"/>
      <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
