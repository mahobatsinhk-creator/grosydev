{%- if request.page_type == 'index' -%}
<script>
(function(){var B='[id*="grosyhub_hero_slider"], .gh-hero-banner';function home(){var m=document.getElementById('MainContent');return m&&m.dataset.template==='index'}function exists(){return!!document.querySelector(B)}function prefix(){var e=document.querySelector('[id^="shopify-section-template--"]');if(!e)return null;var m=e.id.match(/^shopify-section-(template--\d+)__/);return m?m[1]:null}function loadScripts(c){c.querySelectorAll('script[src]').forEach(function(o){var s=o.getAttribute('src');if(!s){o.remove();return}if(Array.from(document.scripts).some(function(x){return x.src===s})){o.remove();return}var n=document.createElement('script');if(o.defer)n.defer=true;n.src=s;o.remove();document.body.appendChild(n)})}function mount(){if(!home()||exists())return;var p=prefix(),r=(window.Shopify&&window.Shopify.routes&&window.Shopify.routes.root)||'/',b=r.endsWith('/')?r:r+'/',urls=[];if(p)urls.push(b+'?section_id='+p+'__grosyhub_hero_slider');urls.push(b+'?sections=grosyhub-hero-slider');function insert(html){if(!html||exists())return false;var main=document.getElementById('MainContent');if(!main)return false;var w=document.createElement('div');w.setAttribute('data-gh-banner-mount','');w.innerHTML=html;loadScripts(w);main.insertBefore(w,main.firstChild);return true}function next(i){if(i>=urls.length||exists())return;fetch(urls[i],{credentials:'same-origin'}).then(function(res){return res.ok?res.json().catch(function(){return res.text()}):Promise.reject()}).then(function(data){var html=typeof data==='string'?data:data&&data['grosyhub-hero-slider'];if(!insert(html))next(i+1)}).catch(function(){next(i+1)})}next(0)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',mount);else mount()})();
</script>
{%- endif -%}
