{%- comment -%} Mobile: scrolling announcement + sticky nav bar only {%- endcomment -%}

{%- if section.settings.show_announcement_mobile -%}
  <div
    class="gh-mobile-announcement gh-announcement gh-announcement--mobile"
    data-gh-announcement-marquee
    role="region"
    aria-label="Store benefits"
  >
    <div class="gh-announcement__viewport">
      <div class="gh-announcement__track">
        <ul class="gh-mobile-announcement__list" role="list">
          {%- for i in (1..5) -%}
            {%- assign key = 'announcement_' | append: i -%}
            {%- assign text = section.settings[key] -%}
            {%- if text != blank -%}
              <li class="gh-mobile-announcement__item">
                {% render 'grosyhub-announcement-icon', index: i %}
                <span>{{ text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <ul class="gh-mobile-announcement__list" aria-hidden="true">
          {%- for i in (1..5) -%}
            {%- assign key = 'announcement_' | append: i -%}
            {%- assign text = section.settings[key] -%}
            {%- if text != blank -%}
              <li class="gh-mobile-announcement__item">
                {% render 'grosyhub-announcement-icon', index: i %}
                <span>{{ text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

<div class="gh-header__mobile-shell">
  <div class="gh-container gh-header__mobile-container">
    <div class="gh-header__mobile-bar">
      <div class="gh-header__mobile-start">
        <button
          type="button"
          class="gh-header__mobile-menu-btn"
          data-gh-nav-toggle
          aria-expanded="false"
          aria-controls="gh-nav-drawer"
          aria-label="Open menu"
        >
          <span class="gh-header__burger" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>

        <button
          type="button"
          class="gh-header__mobile-search-btn"
          data-gh-search-open
          aria-label="{{ 'content.search' | t }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6"/>
            <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <a href="{{ routes.root_url }}" class="gh-header__mobile-logo" aria-label="{{ shop.name }}">
        {% render 'grosyhub-logo', size: 'mobile', link: false %}
      </a>

      <div class="gh-header__mobile-icons">
        <button
          type="button"
          class="gh-header__mobile-icon-btn"
          data-gh-wishlist-open
          aria-label="{{ section.settings.wishlist_label | default: 'Wishlist' }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21s-7.5-4.7-9.8-9.4C.4 8.2 2.6 4 6.4 4c2 0 3.2 1.2 3.6 1.8C10.4 5.2 11.6 4 13.6 4c3.8 0 6 4.2 4.2 7.6C19.5 16.3 12 21 12 21z" stroke="currentColor" stroke-width="1.6"/>
          </svg>
          <span class="gh-badge gh-badge--count" data-gh-wishlist-count-mobile hidden>0</span>
        </button>

        <button
          type="button"
          class="gh-header__mobile-icon-btn"
          data-gh-cart-open
          aria-label="{{ section.settings.cart_label | default: 'Cart' }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 7V6a4 4 0 118 0v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M6 7h12l-1.2 12H7.2L6 7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
          <span class="gh-badge gh-badge--count" data-gh-cart-count>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</div>
