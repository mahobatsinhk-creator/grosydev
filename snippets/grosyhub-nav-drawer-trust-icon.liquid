{%- comment -%} Trust icons for mobile menu drawer footer {%- endcomment -%}
{%- case icon -%}
  {%- when 'secure' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3l7 3v6c0 4.5-3.2 8.4-7 9-3.8-.6-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'returns' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 12a8 8 0 0114-5.3M20 12a8 8 0 01-14 5.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M20 5v4h-4M4 19v-4h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'quality' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/>
      <path d="M12 7l1.2 3.6H17l-3 2.2 1.1 3.5L12 14l-3.1 2.3 1.1-3.5-3-2.2h3.8L12 7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    </svg>
  {%- when 'support' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 14v-2a8 8 0 0116 0v2" stroke="currentColor" stroke-width="1.4"/>
      <path d="M6 14v3a2 2 0 002 2h1v-5H6zm12 0v5h1a2 2 0 002-2v-3h-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
  {%- else -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/>
    </svg>
{%- endcase -%}
