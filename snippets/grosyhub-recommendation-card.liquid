{%- liquid
  assign product = product
  assign variant = product.selected_or_first_available_variant
  assign brand_color = brand_color | default: '#b89774'
  assign compare_at = variant.compare_at_price
  assign price = variant.price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count
  assign rating_value = rating | default: rating_fallback | default: '4.8'
  assign reviews_count = rating_count | default: reviews_count_fallback | default: '108'

  assign is_trending = false
  if force_trending
    assign is_trending = true
  elsif product.tags contains 'trending' or product.tags contains 'Trending'
    assign is_trending = true
  endif

  assign is_bestseller = false
  unless is_trending
    if force_bestseller
      assign is_bestseller = true
    elsif product.tags contains 'bestseller' or product.tags contains 'Bestseller' or product.tags contains 'best-seller'
      assign is_bestseller = true
    endif
  endunless

  assign can_quick_add = false
  if product.variants_count == 1 and variant.available
    assign can_quick_add = true
  endif

-%}

<article class="gh-rec-card" style="--gh-rec-brand: {{ brand_color }};">
  <div class="gh-rec-card__media-wrap">
    <a href="{{ product.url }}" class="gh-rec-card__media-link" aria-label="{{ product.title | escape }}">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 640
          | image_tag:
            class: 'gh-rec-card__image',
            loading: 'lazy',
            widths: '200, 320, 400, 640',
            sizes: '(min-width: 990px) 24vw, (min-width: 750px) 33vw, 85vw',
            alt: product.featured_media.alt | default: product.title
        }}
      {%- else -%}
        <div class="gh-rec-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </a>

    {%- if is_trending -%}
      <span class="gh-rec-card__badge gh-rec-card__badge--trending">Trending</span>
    {%- elsif is_bestseller -%}
      <span class="gh-rec-card__badge gh-rec-card__badge--bestseller">Best Seller</span>
    {%- elsif on_sale -%}
      <span class="gh-rec-card__badge gh-rec-card__badge--sale">Sale</span>
    {%- endif -%}

    <button
      type="button"
      class="gh-rec-card__wishlist"
      data-gh-wishlist-toggle
      data-wishlist-variant-id="{{ variant.id }}"
      data-wishlist-product-id="{{ product.id }}"
      data-wishlist-title="{{ product.title | escape }}"
      data-wishlist-url="{{ product.url }}"
      data-wishlist-image="{% if product.featured_media %}{{ product.featured_media | image_url: width: 200 }}{% endif %}"
      data-wishlist-price="{{ price }}"
      data-wishlist-compare-at="{{ compare_at }}"
      aria-label="Add to wishlist"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 21s-7.5-4.7-9.8-9.4C.4 8.2 2.6 4 6.4 4c2 0 3.2 1.2 3.6 1.8C10.4 5.2 11.6 4 13.6 4c3.8 0 6 4.2 4.2 7.6C19.5 16.3 12 21 12 21z" stroke="currentColor" stroke-width="1.6"/>
      </svg>
    </button>
  </div>

  <div class="gh-rec-card__body">
    <h3 class="gh-rec-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <p class="gh-rec-card__rating">
      <span class="gh-rec-card__stars" aria-hidden="true">
        {%- assign star_rating = rating_value | round -%}
        {%- for i in (1..5) -%}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= star_rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.2">
            <path d="M12 2l2.9 6.1 6.8.6-5.1 4.4 1.6 6.6L12 16.9l-6.2 3.8 1.6-6.6-5.1-4.4 6.8-.6L12 2z"/>
          </svg>
        {%- endfor -%}
      </span>
      <span class="gh-rec-card__rating-text">{{ rating_value }} ({{ reviews_count }})</span>
    </p>

    <div class="gh-rec-card__price-row">
      <span class="gh-rec-card__price">{{ price | money }}</span>
      {%- if on_sale -%}
        <span class="gh-rec-card__compare">{{ compare_at | money }}</span>
      {%- endif -%}
    </div>

    {%- if can_quick_add -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="gh-rec-card__form">
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button type="submit" class="gh-rec-card__btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 7h15l-1.5 9H8L6 7zm3-3h9l1 3H8l1-3z" stroke="currentColor" stroke-width="1.6"/>
          </svg>
          Add to Cart
        </button>
      </form>
    {%- else -%}
      <a href="{{ product.url }}" class="gh-rec-card__btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 7h15l-1.5 9H8L6 7zm3-3h9l1 3H8l1-3z" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        Add to Cart
      </a>
    {%- endif -%}
  </div>
</article>
