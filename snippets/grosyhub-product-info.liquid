{%- liquid
  assign product = product | default: closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant
  assign brand_color = settings.brand_color | default: '#b89774'
  assign compare_at = variant.compare_at_price
  assign price = variant.price
  assign on_sale = false
  if compare_at > price
    assign on_sale = true
    assign savings = compare_at | minus: price
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count
  if rating_count == blank
    assign rating_count = settings.reviews_count_fallback
  endif

  assign can_add_to_cart = false
  if variant.available
    assign can_add_to_cart = true
  endif

  assign price_display = price | money
  assign compare_display = compare_at | money
  assign savings_display = savings | money

  assign spec_material = product.metafields.custom.materials | default: product.metafields.custom.material
  assign spec_weight = product.metafields.custom.item_weight
  assign spec_dimensions = product.metafields.custom.item_dimensions | default: product.metafields.custom.dimensions
  assign spec_uses = product.metafields.custom.uses | default: product.metafields.custom.usage
  assign has_specs = false
  if spec_material != blank or spec_weight != blank or spec_dimensions != blank or spec_uses != blank
    assign has_specs = true
  endif

  assign show_pack_ui = settings.show_pack_selector | default: true
-%}

<div
  class="gh-pdp-info"
  style="--gh-pdp-brand: {{ brand_color }}; --gh-pdp-brand-dark: color-mix(in srgb, {{ brand_color }} 75%, #000000);"
  data-product-id="{{ product.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  <h1 class="gh-pdp-info__title">{{ product.title }}</h1>

  {%- if rating != blank or rating_count != blank -%}
    <div class="gh-pdp-info__rating-row">
      {%- if rating != blank -%}
        <span class="gh-pdp-info__rating-num">{{ rating }}</span>
      {%- endif -%}
      <span class="gh-pdp-info__stars" aria-hidden="true">
        {%- assign star_rating = rating | default: 5 | round -%}
        {%- for i in (1..5) -%}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="{% if i <= star_rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.2">
            <path d="M12 2l2.9 6.1 6.8.6-5.1 4.4 1.6 6.6L12 16.9l-6.2 3.8 1.6-6.6-5.1-4.4 6.8-.6L12 2z"/>
          </svg>
        {%- endfor -%}
      </span>
      {%- if rating_count != blank -%}
        <span class="gh-pdp-info__reviews">{{ rating_count }} Reviews</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="gh-pdp-info__price-row" data-gh-pdp-price>
    <div class="gh-pdp-info__price-block">
      {%- if on_sale -%}
        <span class="gh-pdp-info__price-compare" data-gh-compare>{{ compare_display }}</span>
      {%- else -%}
        <span class="gh-pdp-info__price-compare" data-gh-compare hidden></span>
      {%- endif -%}
      <span class="gh-pdp-info__price-current" data-gh-price>{{ price_display }}</span>
    </div>
    {%- if on_sale -%}
      <span class="gh-pdp-info__save-pill" data-gh-save>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 4h10l1 4H6l1-4zm-1 6h12l-1 10H7L6 10z" stroke="currentColor" stroke-width="1.4"/>
        </svg>
        {{ savings_display }} Save
      </span>
    {%- else -%}
      <span class="gh-pdp-info__save-pill" data-gh-save hidden></span>
    {%- endif -%}
  </div>

  <div class="gh-pdp-info__picker-area">
    {% render 'grosyhub-product-pack-picker',
      product: product,
      show_pack_selector: settings.show_pack_selector,
      pack_discount_inr: settings.pack_bundle_discount
    %}
    <div class="gh-pdp-info__variants-slot{% if show_pack_ui %} visually-hidden{% endif %}"{% if show_pack_ui %} aria-hidden="true"{% endif %}>
      {{ variants_markup }}
    </div>
  </div>

  {%- if settings.show_promo_banner -%}
    <div class="gh-pdp-info__promo" data-gh-promo>
      <div class="gh-pdp-info__promo-inner">
        <span class="gh-pdp-info__promo-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M6 7h12l1 4H5L6 7zm-1 6h14v2H5v-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="gh-pdp-info__promo-text">
          <strong>{{ settings.promo_title }}</strong>
          <span>{{ settings.promo_subtitle }}</span>
        </div>
        <span class="gh-pdp-info__promo-tag">{{ settings.promo_tag }}</span>
      </div>
      <button type="button" class="gh-pdp-info__promo-close" data-gh-promo-close aria-label="Dismiss offer">&times;</button>
    </div>
  {%- endif -%}

  {%- if product != blank -%}
    {%- assign product_form_id = 'GrosyhubProductForm-' | append: section.id -%}
    <product-form-component
      class="gh-pdp-info__form"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      data-quantity-default="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
    >
      <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}" data-gh-variant-input>

        <div class="gh-pdp-info__purchase" ref="productFormButtons">
          <span class="product-form-text__error hidden" ref="addToCartTextError">
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
          </span>

          <div class="gh-pdp-info__qty-cart-row">
            <div class="gh-pdp-info__qty-group">
              <span class="gh-pdp-info__qty-label">{{ 'products.product.quantity' | t }}</span>
              {% render 'quantity-selector', product: product, class: 'gh-pdp-info__quantity-selector' %}
            </div>

            <button
              type="button"
              class="gh-pdp-info__btn-cart"
              {% unless can_add_to_cart %}disabled{% endunless %}
              data-gh-pdp-add-cart
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 7h15l-1.5 9H8L6 7zm3-3h9l1 3H8l1-3z" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              Add to Cart
            </button>
          </div>

          <div class="gh-pdp-info__cta-stack">
            {%- unless product.selected_or_first_available_variant.available -%}
          <style>
           .sr-headless-checkout{
            opacity:0.5;
            cursor: not-allowed;
            pointer-events: none;
           }
          </style>
         {%- endunless -%}
<input type="hidden" value="true" id="fastrrCollectionPage" />
<input type="hidden" value={{ product.url }} name="productUrl" />
            <div class="gh-pdp-info__buy-now-shiprocket">
              {%- if settings.prepaid_note != blank -%}
                <span class="gh-pdp-info__prepaid-badge">{{ settings.prepaid_note }}</span>
              {%- endif -%}
              <div class="shiprocket-headless" data-type="product"></div>
            </div>
            {% comment %} <button
              type="button"
              class="gh-pdp-info__btn-buy{% unless can_add_to_cart %} is-disabled{% endunless %}"
              data-gh-buy-now
              {% unless can_add_to_cart %}disabled aria-disabled="true"{% endunless %}
            >
              {%- if settings.prepaid_note != blank -%}
                <span class="gh-pdp-info__prepaid-badge">{{ settings.prepaid_note }}</span>
              {%- endif -%}
              <span class="gh-pdp-info__btn-buy-start">
                <span class="gh-pdp-info__btn-buy-text">Buy It Now</span>
                <span class="gh-pdp-info__btn-buy-payments" aria-hidden="true">
                  <span class="gh-pdp-info__pay-icon">Pay</span>
                  <span class="gh-pdp-info__pay-icon">UPI</span>
                  <span class="gh-pdp-info__pay-icon">GPay</span>
                </span>
              </span>
              <span class="gh-pdp-info__btn-buy-chevron" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
            </button> {% endcomment %}
          </div>

          <div class="gh-pdp-info__buy-now-wrap visually-hidden" ref="acceleratedCheckoutButtonContainer" aria-hidden="true">
            {{ form | payment_button }}
          </div>
        </div>
      {%- endform -%}
    </product-form-component>
  {%- endif -%}

  {% render 'grosyhub-product-features', brand_color: brand_color, settings: settings %}

  {% render 'grosyhub-pdp-reels',
    product: product,
    section: section,
    settings: settings,
    brand_color: brand_color
  %}

  {%- if settings.show_specs and has_specs -%}
    <details class="gh-pdp-info__accordion">
      <summary>Specifications</summary>
      <table class="gh-pdp-info__specs">
        <tbody>
          {%- if spec_material != blank -%}<tr><th>Material</th><td>{{ spec_material }}</td></tr>{%- endif -%}
          {%- if spec_weight != blank -%}<tr><th>Weight</th><td>{{ spec_weight }}</td></tr>{%- endif -%}
          {%- if spec_dimensions != blank -%}<tr><th>Dimensions</th><td>{{ spec_dimensions }}</td></tr>{%- endif -%}
          {%- if spec_uses != blank -%}<tr><th>Uses</th><td>{{ spec_uses }}</td></tr>{%- endif -%}
        </tbody>
      </table>
    </details>
  {%- endif -%}

  {% render 'grosyhub-product-description-video',
    product: product,
    show: settings.show_description_video,
    heading: settings.description_video_heading,
    autoplay: settings.description_video_autoplay,
    loop: settings.description_video_loop,
    muted: settings.description_video_muted
  %}

  {%- if settings.show_description and product.description != blank -%}
    <div class="gh-pdp-info__description-block">
      <h2 class="gh-pdp-info__description-heading">Product description</h2>
      <div class="gh-pdp-info__description rte">{{ product.description }}</div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'grosyhub-product-info.js' | asset_url }}" defer></script>
<script src="{{ 'grosyhub-product-pack.js' | asset_url }}" defer></script>
