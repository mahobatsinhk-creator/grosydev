{%- liquid
  assign product = product | default: closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = product.selected_or_first_available_variant
  assign brand_color = settings.brand_color | default: '#b89774'
  assign compare_at = variant.compare_at_price
  assign price = variant.price
  assign on_sale = false
  assign discount_pct = 0
  if compare_at > price
    assign on_sale = true
    assign savings = compare_at | minus: price
    assign discount_pct = savings | times: 100.0 | divided_by: compare_at | round
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count
  if rating == blank
    assign rating = 4.8
  endif
  if rating_count == blank
    assign rating_count = settings.reviews_count_fallback
  endif

  assign can_add_to_cart = false
  if variant.available
    assign can_add_to_cart = true
  endif

  assign price_display = price | money_without_trailing_zeros
  assign compare_display = compare_at | money_without_trailing_zeros
  assign savings_display = savings | money_without_trailing_zeros

  assign spec_material = product.metafields.custom.materials | default: product.metafields.custom.material
  assign spec_weight = product.metafields.custom.item_weight
  assign spec_dimensions = product.metafields.custom.item_dimensions | default: product.metafields.custom.dimensions
  assign spec_uses = product.metafields.custom.uses | default: product.metafields.custom.usage
  assign has_specs = false
  if spec_material != blank or spec_weight != blank or spec_dimensions != blank or spec_uses != blank
    assign has_specs = true
  endif

  assign show_pack_ui = settings.show_pack_selector | default: true

  assign now_ts = 'now' | date: '%s'
  assign delivery_start_ts = now_ts | plus: 172800
  assign delivery_end_ts = now_ts | plus: 345600
  assign delivery_start = delivery_start_ts | date: '%a, %-d %b'
  assign delivery_end = delivery_end_ts | date: '%a, %-d %b'
-%}

<div
  class="gh-pdp-info"
  style="--gh-pdp-brand: {{ brand_color }}; --gh-pdp-brand-dark: color-mix(in srgb, {{ brand_color }} 75%, #000000);"
  data-product-id="{{ product.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-currency="{{ cart.currency.iso_code }}"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  {%- if rating != blank or rating_count != blank -%}
    <div class="gh-pdp-info__rating-row">
      {%- if rating != blank -%}
        <span class="gh-pdp-info__rating-num">{{ rating }}</span>
      {%- endif -%}
      <span class="gh-pdp-info__stars" aria-hidden="true">
        {%- assign star_rating = rating | default: 5 | times: 1.0 -%}
        {%- for i in (1..5) -%}
          {%- assign full_at = i -%}
          {%- assign half_at = i | minus: 0.5 -%}
          {%- if star_rating >= full_at -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.2">
              <path d="M12 2l2.9 6.1 6.8.6-5.1 4.4 1.6 6.6L12 16.9l-6.2 3.8 1.6-6.6-5.1-4.4 6.8-.6L12 2z"/>
            </svg>
          {%- elsif star_rating >= half_at -%}
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <defs>
                <linearGradient id="ghStarHalf-{{ section.id }}-{{ i }}">
                  <stop offset="50%" stop-color="currentColor"/>
                  <stop offset="50%" stop-color="transparent"/>
                </linearGradient>
              </defs>
              <path d="M12 2l2.9 6.1 6.8.6-5.1 4.4 1.6 6.6L12 16.9l-6.2 3.8 1.6-6.6-5.1-4.4 6.8-.6L12 2z" fill="url(#ghStarHalf-{{ section.id }}-{{ i }})" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          {%- else -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M12 2l2.9 6.1 6.8.6-5.1 4.4 1.6 6.6L12 16.9l-6.2 3.8 1.6-6.6-5.1-4.4 6.8-.6L12 2z"/>
            </svg>
          {%- endif -%}
        {%- endfor -%}
      </span>
      {%- if rating_count != blank -%}
        <span class="gh-pdp-info__reviews">{{ rating_count }} Reviews</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <h1 class="gh-pdp-info__title">{{ product.title }}</h1>

  <div class="gh-pdp-info__price-row" data-gh-pdp-price>
    <span class="gh-pdp-info__price-current" data-gh-price>{{ price_display }}</span>
    {%- if on_sale -%}
      <span class="gh-pdp-info__price-compare" data-gh-compare>{{ compare_display }}</span>
      <span class="gh-pdp-info__save-pill" data-gh-save>
        <span data-gh-save-pct>{{ discount_pct }}% OFF</span>
        <span aria-hidden="true">·</span>
        <span data-gh-save-amt>Save {{ savings_display }}</span>
      </span>
    {%- else -%}
      <span class="gh-pdp-info__price-compare" data-gh-compare hidden></span>
      <span class="gh-pdp-info__save-pill" data-gh-save hidden>
        <span data-gh-save-pct></span>
        <span aria-hidden="true">·</span>
        <span data-gh-save-amt></span>
      </span>
    {%- endif -%}
  </div>
  <p class="gh-pdp-info__tax-note">Incl. of all taxes</p>

  <div class="gh-pdp-info__highlights" aria-label="Purchase benefits">
    <div class="gh-pdp-info__highlight">
      <span class="gh-pdp-info__highlight-icon gh-pdp-info__highlight-icon--delivery" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M1 7h13v9H6l-4 3V7zm14 2h4l3 4v5h-7V9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="7.5" cy="18.5" r="1.5" fill="currentColor"/>
          <circle cx="17.5" cy="18.5" r="1.5" fill="currentColor"/>
        </svg>
      </span>
      <span>Free Delivery</span>
    </div>
    <div class="gh-pdp-info__highlight">
      <span class="gh-pdp-info__highlight-icon gh-pdp-info__highlight-icon--cod" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
          <path d="M3 10h18" stroke="currentColor" stroke-width="1.6"/>
          <path d="M8 14h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </span>
      <span>COD</span>
    </div>
    <div class="gh-pdp-info__highlight">
      <span class="gh-pdp-info__highlight-icon gh-pdp-info__highlight-icon--returns" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M4 12a8 8 0 1 0 2.3-5.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M4 5v4h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span>7-Day Returns</span>
    </div>
  </div>

  <div class="gh-pdp-info__picker-area">
    {% render 'grosyhub-product-pack-picker',
      product: product,
      show_pack_selector: settings.show_pack_selector,
      pack_discount_inr: settings.pack_bundle_discount,
      bestseller_label: settings.pack_bestseller_label
    %}
    <div class="gh-pdp-info__variants-slot{% if show_pack_ui %} visually-hidden{% endif %}"{% if show_pack_ui %} aria-hidden="true"{% endif %}>
      {{ variants_markup }}
    </div>
  </div>

  {%- if settings.show_promo_banner -%}
    <div class="gh-pdp-info__promo" data-gh-promo>
      <div class="gh-pdp-info__promo-inner">
        <span class="gh-pdp-info__promo-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M6 7h12l1 4H5L6 7zm-1 6h14v2H5v-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
          </svg>
        </span>
        <div class="gh-pdp-info__promo-text">
          <strong>{{ settings.promo_title }}</strong>
          <span>{{ settings.promo_subtitle }}</span>
        </div>
        <span class="gh-pdp-info__promo-tag">{{ settings.promo_tag }}</span>
      </div>
      <button type="button" class="gh-pdp-info__promo-close" data-gh-promo-close aria-label="Dismiss offer">&times;</button>
    </div>
  {%- endif -%}

  {%- if product != blank -%}
    {%- assign product_form_id = 'GrosyhubProductForm-' | append: section.id -%}
    <product-form-component
      class="gh-pdp-info__form"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      data-quantity-default="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
    >
      <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}" data-gh-variant-input>

        <div class="gh-pdp-info__purchase" ref="productFormButtons">
          <span class="product-form-text__error hidden" ref="addToCartTextError">
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
          </span>

          <div class="gh-pdp-info__buy-block">
            <div class="gh-pdp-info__buy-row">
              <div class="gh-pdp-info__qty-box">
                {% render 'quantity-selector', product: product, class: 'gh-pdp-info__quantity-selector' %}
              </div>

              <div class="gh-pdp-info__buy-cta">
                {%- if settings.prepaid_note != blank -%}
                  <span class="gh-pdp-info__prepaid-badge">{{ settings.prepaid_note }}</span>
                {%- endif -%}
                {% comment %}
                  GoKwik Buy It Now — keep this button so GoKwik can attach.
                {% endcomment %}
                <button
                  type="button"
                  class="gh-pdp-info__btn-buy{% unless can_add_to_cart %} is-disabled{% endunless %}"
                  data-gh-buy-now
                  {% unless can_add_to_cart %}disabled aria-disabled="true"{% endunless %}
                >
                  <span class="gh-pdp-info__btn-buy-text">Buy It Now</span>
                </button>
              </div>
            </div>
          </div>

          <div class="gh-pdp-info__buy-now-wrap visually-hidden" ref="acceleratedCheckoutButtonContainer" aria-hidden="true">
            {{ form | payment_button }}
          </div>
        </div>
      {%- endform -%}
    </product-form-component>

    {%- comment -%} ── Sticky bottom bar (mobile only) ── {%- endcomment -%}
    <div class="gh-pdp-sticky-bar" data-gh-sticky-bar aria-hidden="true">
      <div class="gh-pdp-sticky-bar__inner">
        <div class="gh-pdp-sticky-bar__qty" data-gh-sticky-qty>
          <button type="button" class="gh-pdp-sticky-bar__qty-btn" data-gh-sticky-minus aria-label="Decrease quantity">−</button>
          <span class="gh-pdp-sticky-bar__qty-num" data-gh-sticky-num>1</span>
          <button type="button" class="gh-pdp-sticky-bar__qty-btn" data-gh-sticky-plus aria-label="Increase quantity">+</button>
        </div>
        <div class="gh-pdp-sticky-bar__buy-wrap">
          {%- if settings.prepaid_note != blank -%}
            <span class="gh-pdp-info__prepaid-badge gh-pdp-sticky-bar__badge">{{ settings.prepaid_note }}</span>
          {%- endif -%}
          <button type="button" class="gh-pdp-info__btn-buy gh-pdp-sticky-bar__buy-btn{% unless can_add_to_cart %} is-disabled{% endunless %}" data-gh-sticky-buy {% unless can_add_to_cart %}disabled aria-disabled="true"{% endunless %}>
            <span class="gh-pdp-info__btn-buy-text">Buy It Now</span>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}

  {% comment %} Trust grid hidden on mobile — highlights bar covers the same job {% endcomment %}
  <div class="gh-pdp-info__trust-wrap">
    {% render 'grosyhub-product-features', brand_color: brand_color, settings: settings %}
  </div>

  {% comment %} PDP reels — swipe/drag scroll, no arrows {% endcomment %}
  {% render 'grosyhub-pdp-reels',
    product: product,
    section: section,
    settings: settings,
    brand_color: brand_color
  %}

  {%- if settings.show_specs and has_specs -%}
    <details class="gh-pdp-info__accordion">
      <summary>Specifications</summary>
      <table class="gh-pdp-info__specs">
        <tbody>
          {%- if spec_material != blank -%}<tr><th>Material</th><td>{{ spec_material }}</td></tr>{%- endif -%}
          {%- if spec_weight != blank -%}<tr><th>Weight</th><td>{{ spec_weight }}</td></tr>{%- endif -%}
          {%- if spec_dimensions != blank -%}<tr><th>Dimensions</th><td>{{ spec_dimensions }}</td></tr>{%- endif -%}
          {%- if spec_uses != blank -%}<tr><th>Uses</th><td>{{ spec_uses }}</td></tr>{%- endif -%}
        </tbody>
      </table>
    </details>
  {%- endif -%}

  {% render 'grosyhub-product-description-video',
    product: product,
    show: settings.show_description_video,
    heading: settings.description_video_heading,
    autoplay: settings.description_video_autoplay,
    loop: settings.description_video_loop,
    muted: settings.description_video_muted
  %}

  {%- if settings.show_description and product.description != blank -%}
    <div class="gh-pdp-info__description-block">
      <h2 class="gh-pdp-info__description-heading">Product description</h2>
      <div class="gh-pdp-info__description rte">{{ product.description }}</div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'grosyhub-product-info.js' | asset_url }}" defer></script>
<script src="{{ 'grosyhub-product-pack.js' | asset_url }}" defer></script>
<script>
(function () {
  function initStickyBar(pdp) {
    var bar = pdp.querySelector('[data-gh-sticky-bar]');
    if (!bar || bar._ghStickyInit) return;
    bar._ghStickyInit = true;

    var mainPurchase = pdp.querySelector('.gh-pdp-info__purchase');
    var mainQtyInput = pdp.querySelector('.gh-pdp-info__quantity-selector input[type="number"]');
    var mainBuyBtn   = pdp.querySelector('[data-gh-buy-now]');

    var stickyNum   = bar.querySelector('[data-gh-sticky-num]');
    var stickyMinus = bar.querySelector('[data-gh-sticky-minus]');
    var stickyPlus  = bar.querySelector('[data-gh-sticky-plus]');
    var stickyBuy   = bar.querySelector('[data-gh-sticky-buy]');

    var qty = 1;

    function readQty() { if (mainQtyInput) qty = parseInt(mainQtyInput.value, 10) || 1; }
    function syncNum() { if (stickyNum) stickyNum.textContent = qty; }

    function writeQty(val) {
      qty = Math.max(1, val);
      syncNum();
      if (mainQtyInput) {
        mainQtyInput.value = qty;
        mainQtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        mainQtyInput.dispatchEvent(new Event('input',  { bubbles: true }));
      }
      var qtyComp = pdp.querySelector('quantity-selector-component');
      if (qtyComp && qtyComp.setValue) qtyComp.setValue(qty);
    }

    if (mainQtyInput) {
      mainQtyInput.addEventListener('change', function () { readQty(); syncNum(); });
      mainQtyInput.addEventListener('input',  function () { readQty(); syncNum(); });
    }

    if (stickyMinus) stickyMinus.addEventListener('click', function () { writeQty(qty - 1); });
    if (stickyPlus)  stickyPlus.addEventListener('click',  function () { writeQty(qty + 1); });

    if (stickyBuy) {
      stickyBuy.addEventListener('click', function () {
        writeQty(qty);
        if (mainBuyBtn && !mainBuyBtn.disabled) mainBuyBtn.click();
      });
    }

    if (mainPurchase && window.IntersectionObserver) {
      var io = new IntersectionObserver(function (entries) {
        var vis = entries[0].isIntersecting;
        bar.classList.toggle('is-visible', !vis);
        bar.setAttribute('aria-hidden', vis ? 'true' : 'false');
      }, { threshold: 0, rootMargin: '0px 0px -20px 0px' });
      io.observe(mainPurchase);
    }

    readQty();
    syncNum();
  }

  function initAll() {
    document.querySelectorAll('.gh-pdp-info').forEach(initStickyBar);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
})();
</script>
