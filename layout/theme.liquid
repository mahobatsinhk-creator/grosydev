      </svg>
    </a>
    <script>
      (function ensureWhatsAppButtonVisible() {
        var id = 'grosyhub-whatsapp-float';
        var existing = document.getElementById(id);
        if (existing) return;
        var a = document.createElement('a');
        a.id = id;
        a.className = 'grosyhub-whatsapp-float';
        a.href = 'https://wa.me/918866559670?text=Hi%20Grosyhub%2C%20I%20need%20help%20with%20my%20order.';
        a.target = '_blank';
        a.rel = 'noopener';
        a.setAttribute('aria-label', 'Chat with Grosyhub on WhatsApp');
        a.setAttribute('title', 'Chat on WhatsApp');
        a.innerHTML =
          '<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M19.11 17.25c-.26-.13-1.52-.75-1.76-.83-.23-.09-.4-.13-.57.13-.17.26-.66.83-.81 1-.15.17-.3.19-.56.06-.26-.13-1.11-.41-2.11-1.31-.78-.69-1.31-1.55-1.47-1.81-.15-.26-.02-.4.11-.53.12-.12.26-.3.39-.45.13-.15.17-.26.26-.43.09-.17.04-.32-.02-.45-.06-.13-.57-1.37-.78-1.88-.21-.5-.42-.43-.57-.44-.15-.01-.32-.01-.49-.01-.17 0-.45.06-.68.32-.23.26-.89.87-.89 2.11 0 1.24.91 2.43 1.03 2.59.13.17 1.78 2.72 4.32 3.81.6.26 1.08.42 1.45.54.61.19 1.16.16 1.6.1.49-.07 1.52-.62 1.73-1.21.21-.6.21-1.11.15-1.21-.06-.1-.23-.16-.49-.29zM16.13 28h-.01a11.9 11.9 0 0 1-6.07-1.66L4 28l1.7-5.98a11.88 11.88 0 0 1-1.81-6.28C3.9 9.23 9.13 4 15.56 4c3.12 0 6.04 1.22 8.25 3.43a11.59 11.59 0 0 1 3.41 8.23C27.2 22.77 21.97 28 15.56 28h.57zm-.57-21.9c-5.48 0-9.93 4.45-9.93 9.93 0 2 .6 3.92 1.74 5.56l.28.41-1.01 3.55 3.64-.95.39.23a9.95 9.95 0 0 0 4.89 1.28h.01c5.47 0 9.92-4.46 9.93-9.93 0-2.66-1.04-5.16-2.92-7.04a9.85 9.85 0 0 0-7.02-2.94z"/></svg>';
        document.body.appendChild(a);
      })();
    </script>

  </body>
</html>
