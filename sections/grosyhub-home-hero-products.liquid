{{ 'grosyhub-section-header.css' | asset_url | stylesheet_tag }}
{{ 'grosyhub-home-hero-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'grosyhub-home-hero-products.js' | asset_url }}" defer></script>

{%- liquid
  assign brand_color = section.settings.brand_color | default: '#A56A2A'
  assign featured_blocks = section.blocks | where: 'type', 'featured_card'
  assign promo_blocks = section.blocks | where: 'type', 'promo_banner'
-%}

<section
  class="gh-hp section-{{ section.id }}"
  style="--gh-sec-brand: {{ brand_color }}; --gh-hp-brand: {{ brand_color }}; --gh-rec-brand: {{ brand_color }}; --gh-hp-brand-dark: color-mix(in srgb, {{ brand_color }} 82%, #3d2810);"
  {{ section.shopify_attributes }}
>
  <div class="gh-hp__bg" aria-hidden="true">
    <span class="gh-hp__orb gh-hp__orb--1"></span>
    <span class="gh-hp__orb gh-hp__orb--2"></span>
    <span class="gh-hp__orb gh-hp__orb--3"></span>
    <span class="gh-hp__shape gh-hp__shape--ring"></span>
    <span class="gh-hp__shape gh-hp__shape--arc"></span>
    <span class="gh-hp__grain"></span>
  </div>

  <div class="gh-hp__container">
    {% render 'grosyhub-section-header',
      eyebrow: section.settings.eyebrow,
      subheading: section.settings.subheading,
      view_all_url: '',
      view_all_label: '',
      icon: 'star'
    %}

    {%- if featured_blocks.size > 0 -%}
      <div class="gh-hp__featured">
        {%- for block in featured_blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            if card_product == blank and block.settings.collection != blank
              assign card_product = block.settings.collection.products.first
            endif

            assign card_theme = block.settings.card_theme | default: 'warm'
            assign badge_type = block.settings.badge_type | default: 'bestseller'
            assign can_quick_add = false

            if card_product != blank
              assign card_variant = card_product.selected_or_first_available_variant
              assign card_price = card_variant.price
              assign card_compare = card_variant.compare_at_price
              assign on_sale = false
              if card_compare > card_price
                assign on_sale = true
                assign save_amount = card_compare | minus: card_price
                assign discount_pct = save_amount | times: 100 | divided_by: card_compare
              endif
              if block.settings.discount_override != blank
                assign discount_pct = block.settings.discount_override | plus: 0
                assign on_sale = true
              endif
              assign display_compare = card_compare
              if on_sale and display_compare <= card_price and discount_pct > 0
                assign pct_remain = 100 | minus: discount_pct
                if pct_remain > 0
                  assign display_compare = card_price | times: 100 | divided_by: pct_remain
                endif
              endif
              if card_product.variants_count == 1 and card_variant.available
                assign can_quick_add = true
              endif
              assign card_heading = card_product.title
              if block.settings.title_override != blank
                assign card_heading = block.settings.title_override
              endif
            endif
          -%}

          {%- if card_product == blank -%}
            <article class="gh-hp__card gh-hp__card--{{ card_theme }}" {{ block.shopify_attributes }}>
              <p class="gh-hp__empty">{{ section.settings.empty_card_text | default: 'Select a product for this hero card.' }}</p>
            </article>
          {%- else -%}
            <article
              class="gh-hp__card gh-hp__card--{{ card_theme }}"
              {{ block.shopify_attributes }}
            >
              <span class="gh-hp__card-badge gh-hp__card-badge--glass gh-hp__card-badge--{{ badge_type }}">
                {%- if badge_type == 'bestseller' -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M13 2L4 14h7l-1 8 10-14H13V2z"/>
                  </svg>
                  {{ block.settings.badge_text | default: 'BESTSELLER' }}
                {%- elsif badge_type == 'trending' -%}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M16 6l2.3 4.7 5.2.8-3.8 3.6.9 5.3L16 17.3l-4.6 2.1.9-5.3-3.8-3.6 5.2-.8L16 6z"/>
                  </svg>
                  {{ block.settings.badge_text | default: 'TRENDING' }}
                {%- else -%}
                  {{ block.settings.badge_text }}
                {%- endif -%}
              </span>

              <div class="gh-hp__card-inner">
                <div class="gh-hp__card-content">
                  <h3 class="gh-hp__card-title">
                    <a href="{{ card_product.url }}">{{ card_heading }}</a>
                  </h3>

                  {%- if block.settings.subtitle != blank -%}
                    <p class="gh-hp__card-desc">{{ block.settings.subtitle }}</p>
                  {%- elsif card_product.description != blank -%}
                    <p class="gh-hp__card-desc">{{ card_product.description | strip_html | truncate: 120 }}</p>
                  {%- endif -%}

                  <div class="gh-hp__card-price">
                    <div class="gh-hp__card-price-row">
                      <span class="gh-hp__card-price-current">{{ card_price | money }}</span>
                      {%- if on_sale and display_compare > card_price -%}
                        <span class="gh-hp__card-compare">{{ display_compare | money }}</span>
                      {%- endif -%}
                      {%- if on_sale and discount_pct > 0 -%}
                        <span class="gh-hp__card-off-pill">{{ discount_pct }}% OFF</span>
                      {%- endif -%}
                    </div>
                  </div>

                  <div class="gh-hp__card-actions">
                    <a href="{{ card_product.url }}" class="gh-hp__card-shop">
                      {{ block.settings.shop_label | default: 'Shop Now' }}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </a>
                    {%- if can_quick_add -%}
                      <button
                        type="button"
                        class="gh-hp__card-cart"
                        data-gh-hp-add-cart="{{ card_variant.id }}"
                        aria-label="Add to cart"
                      >
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                          <path d="M6 7h15l-1.5 9H8L6 7zm3-3h9l1 3H8l1-3z" stroke="currentColor" stroke-width="1.6"/>
                        </svg>
                      </button>
                    {%- else -%}
                      <a href="{{ card_product.url }}" class="gh-hp__card-cart" aria-label="View product">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                          <path d="M6 7h15l-1.5 9H8L6 7zm3-3h9l1 3H8l1-3z" stroke="currentColor" stroke-width="1.6"/>
                        </svg>
                      </a>
                    {%- endif -%}
                  </div>
                </div>

                <div class="gh-hp__card-visual">
                  <div class="gh-hp__card-texture" aria-hidden="true"></div>
                  <div class="gh-hp__card-deco" aria-hidden="true"></div>
                  <span class="gh-hp__float gh-hp__float--1" aria-hidden="true"></span>
                  <span class="gh-hp__float gh-hp__float--2" aria-hidden="true"></span>
                  {%- if block.settings.offer_label != blank -%}
                    <div class="gh-hp__offer-ring">{{ block.settings.offer_label | newline_to_br }}</div>
                  {%- endif -%}
                  <div class="gh-hp__card-glow" aria-hidden="true"></div>
                  <div class="gh-hp__card-halo" aria-hidden="true"></div>
                  <div class="gh-hp__card-pedestal-top" aria-hidden="true"></div>
                  <div class="gh-hp__card-pedestal" aria-hidden="true"></div>
                  <div class="gh-hp__card-img-frame">
                    <span class="gh-hp__card-img-floor" aria-hidden="true"></span>
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          class: 'gh-hp__card-img',
                          loading: 'lazy',
                          widths: '400,600,800,900',
                          sizes: '(min-width: 990px) 300px, 50vw',
                          alt: card_product.title
                      }}
                    {%- elsif card_product.featured_media -%}
                      {{
                        card_product.featured_media
                        | image_url: width: 900
                        | image_tag:
                          class: 'gh-hp__card-img',
                          loading: 'lazy',
                          widths: '400,600,800,900',
                          sizes: '(min-width: 990px) 300px, 50vw',
                          alt: card_product.featured_media.alt | default: card_product.title
                      }}
                    {%- endif -%}
                  </div>
                </div>
              </div>

              <ul class="gh-hp__card-perks">
                {%- for i in (1..3) -%}
                  {%- capture perk_key -%}perk_{{ i }}{%- endcapture -%}
                  {%- assign perk_text = block.settings[perk_key] -%}
                  {%- if perk_text != blank -%}
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        {%- if i == 1 -%}
                          <path d="M12 3l2.5 4.5 5 .8-3.6 3.3.9 5.2L12 14.8 7.2 17l.9-5.2L4.5 8.3l5-.8L12 3z" stroke="currentColor" stroke-width="1.4"/>
                        {%- elsif i == 2 -%}
                          <path d="M4 7h16v10H4V7zm2-3h12l2 3H6l-2-3z" stroke="currentColor" stroke-width="1.4"/>
                        {%- else -%}
                          <path d="M12 3l7 4v6c0 4-3 7-7 8-4-1-7-4-7-8V7l7-4z" stroke="currentColor" stroke-width="1.4"/>
                        {%- endif -%}
                      </svg>
                      {{ perk_text }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if promo_blocks.size > 0 -%}
      <div class="gh-hp__promos">
        {%- for block in promo_blocks -%}
          {%- liquid
            assign promo_product = block.settings.product
            assign promo_url = block.settings.link
            if promo_url == blank and promo_product != blank
              assign promo_url = promo_product.url
            endif
            if promo_url == blank
              assign promo_url = '#'
            endif
            assign promo_theme = block.settings.banner_theme | default: 'cream'
          -%}

          <a href="{{ promo_url }}" class="gh-hp__promo gh-hp__promo--{{ promo_theme }}" {{ block.shopify_attributes }}>
            <div class="gh-hp__promo-inner">
              <div class="gh-hp__promo-text">
                <h3 class="gh-hp__promo-title">{{ block.settings.title }}</h3>
                {%- if block.settings.subtitle != blank -%}
                  <p class="gh-hp__promo-sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <span class="gh-hp__promo-btn">
                  {{ block.settings.button_label | default: 'Shop now' }}
                  {%- unless promo_theme == 'peach' -%}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  {%- endunless -%}
                </span>
              </div>
              <div class="gh-hp__promo-visual">
                {%- if block.settings.circle_badge != blank -%}
                  <span class="gh-hp__promo-ring{% if promo_theme == 'lavender' %} gh-hp__promo-ring--purple{% endif %}">
                    {{ block.settings.circle_badge | newline_to_br }}
                  </span>
                {%- endif -%}
                <div class="gh-hp__promo-pedestal" aria-hidden="true"></div>
                <div class="gh-hp__promo-img-frame">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 500
                      | image_tag: class: 'gh-hp__promo-img', loading: 'lazy', widths: '200,300,500', sizes: '160px', alt: block.settings.title
                    }}
                  {%- elsif promo_product != blank and promo_product.featured_media -%}
                    {{
                      promo_product.featured_media
                      | image_url: width: 500
                      | image_tag: class: 'gh-hp__promo-img', loading: 'lazy', widths: '200,300,500', sizes: '160px', alt: promo_product.title
                    }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_trust_bar -%}
      <ul class="gh-hp__trust">
        {%- if section.settings.trust_1 != blank -%}
          <li>
            <span class="gh-hp__trust-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 7h13v8H3V7zm13 0h3l2 4v4h-5V7zM2 5h14v2H2V5z" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
            <span class="gh-hp__trust-text">
              <strong>{{ section.settings.trust_1 }}</strong>
              {%- if section.settings.trust_1_sub != blank -%}<span>{{ section.settings.trust_1_sub }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.trust_2 != blank -%}
          <li>
            <span class="gh-hp__trust-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6h16v12H4V6zm2 2v8h12V8H6z" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
            <span class="gh-hp__trust-text">
              <strong>{{ section.settings.trust_2 }}</strong>
              {%- if section.settings.trust_2_sub != blank -%}<span>{{ section.settings.trust_2_sub }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.trust_3 != blank -%}
          <li>
            <span class="gh-hp__trust-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 4v6c0 4-3 7-7 8-4-1-7-4-7-8V7l7-4z" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
            <span class="gh-hp__trust-text">
              <strong>{{ section.settings.trust_3 }}</strong>
              {%- if section.settings.trust_3_sub != blank -%}<span>{{ section.settings.trust_3_sub }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
        {%- if section.settings.trust_4 != blank -%}
          <li>
            <span class="gh-hp__trust-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4V7zm2-3h12l2 3H6l-2-3z" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
            <span class="gh-hp__trust-text">
              <strong>{{ section.settings.trust_4 }}</strong>
              {%- if section.settings.trust_4_sub != blank -%}<span>{{ section.settings.trust_4_sub }}</span>{%- endif -%}
            </span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Grosyhub hero products",
  "tag": "section",
  "class": "grosyhub-hero-products-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand color",
      "default": "#A56A2A"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Top badge",
      "default": "OUR HERO PRODUCTS",
      "info": "Shown between dashes with trophy icon."
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading (before highlight)",
      "default": "Game-changing products"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight",
      "default": "loved by thousands"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handpicked bestsellers and trending favorites that make a real difference"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust 1 title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_1_sub",
      "label": "Trust 1 subtitle",
      "default": "On orders over Rs. 499"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust 2 title",
      "default": "7 Days Easy Returns"
    },
    {
      "type": "text",
      "id": "trust_2_sub",
      "label": "Trust 2 subtitle",
      "default": "Hassle-free returns"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust 3 title",
      "default": "Secure Payments"
    },
    {
      "type": "text",
      "id": "trust_3_sub",
      "label": "Trust 3 subtitle",
      "default": "100% safe & secure"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Trust 4 title",
      "default": "COD Available"
    },
    {
      "type": "text",
      "id": "trust_4_sub",
      "label": "Trust 4 subtitle",
      "default": "Cash on delivery"
    },
    {
      "type": "text",
      "id": "empty_card_text",
      "label": "Empty card message",
      "default": "Select a product for this hero card."
    }
  ],
  "blocks": [
    {
      "type": "featured_card",
      "name": "Featured product card",
      "limit": 2,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Fallback collection",
          "info": "Used if no product is selected."
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card color theme",
          "options": [
            { "value": "warm", "label": "Warm gold & beige" },
            { "value": "purple", "label": "Soft mocha & champagne" }
          ],
          "default": "warm"
        },
        {
          "type": "select",
          "id": "badge_type",
          "label": "Badge style",
          "options": [
            { "value": "bestseller", "label": "Bestseller" },
            { "value": "trending", "label": "Trending" },
            { "value": "custom", "label": "Custom text only" }
          ],
          "default": "bestseller"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "BESTSELLER"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Product title override",
          "info": "Optional display title (e.g. shorter marketing name)."
        },
        {
          "type": "textarea",
          "id": "offer_label",
          "label": "Circle offer badge",
          "default": "LIMITED TIME\n45% OFF"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Short description",
          "info": "Leave blank to use product description excerpt."
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Promotes Relaxation"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Ergonomic Design"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": "Easy to Use"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "feature_5",
          "label": "Feature 5 (optional)"
        },
        {
          "type": "text",
          "id": "perk_1",
          "label": "Bottom perk 1",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "perk_2",
          "label": "Bottom perk 2",
          "default": "Ergonomic Design"
        },
        {
          "type": "text",
          "id": "perk_3",
          "label": "Bottom perk 3",
          "default": "Easy to Use"
        },
        {
          "type": "text",
          "id": "shop_label",
          "label": "Shop button label",
          "default": "Shop Now"
        },
        {
          "type": "text",
          "id": "discount_override",
          "label": "Discount % override",
          "info": "Optional. Shows sale pill even if compare-at is not set."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image override"
        }
      ]
    },
    {
      "type": "promo_banner",
      "name": "Promo banner",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Summer Sale"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (image & link fallback)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "select",
          "id": "banner_theme",
          "label": "Banner style",
          "options": [
            { "value": "cream", "label": "Cream gold" },
            { "value": "lavender", "label": "Mocha blush" },
            { "value": "peach", "label": "Warm sand" }
          ],
          "default": "cream"
        },
        {
          "type": "textarea",
          "id": "circle_badge",
          "label": "Circle badge (optional)",
          "default": "UP TO\n40% OFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Grosyhub hero products",
      "blocks": [
        {
          "type": "featured_card",
          "settings": {
            "card_theme": "warm",
            "badge_type": "bestseller",
            "offer_label": "LIMITED TIME\n45% OFF",
            "feature_1": "Promotes Relaxation",
            "feature_2": "Ergonomic Design",
            "feature_3": "Easy to Use",
            "feature_4": "Premium Quality",
            "perk_1": "Premium Quality",
            "perk_2": "Ergonomic Design",
            "perk_3": "Easy to Use"
          }
        },
        {
          "type": "featured_card",
          "settings": {
            "card_theme": "purple",
            "badge_type": "trending",
            "badge_text": "TRENDING",
            "offer_label": "LIMITED TIME\n55% OFF",
            "feature_1": "Ice Therapy",
            "feature_2": "Skin Care",
            "feature_3": "Reusable",
            "feature_4": "Portable",
            "perk_1": "Premium Quality",
            "perk_2": "Portable & Foldable",
            "perk_3": "Safe Material"
          }
        },
        {
          "type": "promo_banner",
          "settings": {
            "title": "Summer Sale",
            "banner_theme": "cream",
            "circle_badge": "UP TO\n40% OFF"
          }
