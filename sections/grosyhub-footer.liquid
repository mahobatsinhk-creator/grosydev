{{ 'grosyhub-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign brand_color = section.settings.brand_color | default: '#b89774'
  assign categories_menu = section.settings.categories_menu
  assign quick_menu = section.settings.quick_links_menu
  assign year = 'now' | date: '%Y'
-%}

<footer class="gh-footer" style="--gh-ft-brand: {{ brand_color }};" {{ section.shopify_attributes }}>
  {%- if section.settings.show_newsletter -%}
    <div class="gh-container">
      <section class="gh-footer__newsletter" aria-labelledby="gh-footer-newsletter-title">
        <span class="gh-footer__newsletter-deco gh-footer__newsletter-deco--left" aria-hidden="true"></span>
        <span class="gh-footer__newsletter-deco gh-footer__newsletter-deco--right" aria-hidden="true"></span>
        <div class="gh-footer__newsletter-inner">
          <h2 id="gh-footer-newsletter-title" class="gh-footer__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="gh-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'gh-footer__newsletter-form', id: 'gh-footer-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="gh-footer__newsletter-input-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 6h16v12H4V6zm0 0l8 7 8-7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              </svg>
              <label class="visually-hidden" for="gh-footer-email">{{ 'newsletter.label' | t }}</label>
              <input
                id="gh-footer-email"
                class="gh-footer__newsletter-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocomplete="email"
                required
              >
            </div>
            <button type="submit" class="gh-footer__newsletter-btn">
              {{ section.settings.newsletter_button }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          {%- endform -%}

          {%- if form.posted_successfully? -%}
            <p class="gh-footer__newsletter-msg gh-footer__newsletter-msg--ok">{{ section.settings.newsletter_success }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="gh-footer__newsletter-msg gh-footer__newsletter-msg--err">{{ form.errors.messages.email }}</p>
          {%- endif -%}

          <ul class="gh-footer__newsletter-perks" role="list">
            {%- if section.settings.perk_1 != blank -%}
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16v12H4V6zm0 0l8 7 8-7" stroke="currentColor" stroke-width="1.4"/></svg>
                {{ section.settings.perk_1 }}
              </li>
            {%- endif -%}
            {%- if section.settings.perk_2 != blank -%}
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 7h12l1 4H5L6 7zm-1 6h14v2H5v-2z" stroke="currentColor" stroke-width="1.4"/></svg>
                {{ section.settings.perk_2 }}
              </li>
            {%- endif -%}
            {%- if section.settings.perk_3 != blank -%}
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 6v6l4 2M12 3a9 9 0 110 18 9 9 0 010-18z" stroke="currentColor" stroke-width="1.4"/></svg>
                {{ section.settings.perk_3 }}
              </li>
            {%- endif -%}
          </ul>
        </div>
      </section>
    </div>
  {%- endif -%}

  <div class="gh-footer__main">
    <div class="gh-container">
      <div class="gh-footer__grid">
        <div class="gh-footer__col gh-footer__brand-col">
          <div class="gh-footer__col-panel">
            <div class="gh-footer__brand">
              {% render 'grosyhub-logo', size: 'desktop' %}
              {%- if section.settings.brand_description != blank -%}
                <p class="gh-footer__brand-text">{{ section.settings.brand_description }}</p>
              {%- endif -%}
            </div>
            <ul class="gh-footer__trust-list" role="list">
              {%- for i in (1..4) -%}
                {%- assign tk = 'brand_trust_' | append: i -%}
                {%- assign tv = section.settings[tk] -%}
                {%- if tv != blank -%}
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      {%- case i -%}
                        {%- when 1 -%}<path d="M12 3l7 3v5c0 4.5-3.2 8.4-7 9-3.8-.6-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4"/>
                        {%- when 2 -%}<path d="M4 7h12l2 4v6H6l-2-4V7z" stroke="currentColor" stroke-width="1.4"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.4"/>
                        {%- when 3 -%}<path d="M12 3l2.4 4.8 5.4.8-3.9 3.8.9 5.4L12 16.8 7.2 17l.9-5.4-3.9-3.8 5.4-.8L12 3z" stroke="currentColor" stroke-width="1.4"/>
                        {%- else -%}<path d="M17 21s-1-.5-4-2.5C10 16.5 7 21 7 21M12 11a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="1.4"/>
                      {%- endcase -%}
                    </svg>
                    {{ tv }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {%- if section.settings.show_social -%}
              <p class="gh-footer__social-title">{{ section.settings.social_heading }}</p>
              <div class="gh-footer__social">
                {%- if section.settings.facebook_url != blank -%}
                  <a href="{{ section.settings.facebook_url }}" aria-label="Facebook" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V5h-3c-2.8 0-5 2.2-5 5v2H7v3h2v9h3v-9h2.7l.3-3H12V9c0-.6.4-1 1-1z"/></svg>
                  </a>
                {%- endif -%}
                {%- if section.settings.instagram_url != blank -%}
                  <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="7" r="1" fill="currentColor"/></svg>
                  </a>
                {%- endif -%}
                {%- if section.settings.pinterest_url != blank -%}
                  <a href="{{ section.settings.pinterest_url }}" aria-label="Pinterest" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.1-2 .2-3 .2-.9 1.4-5.9 1.4-5.9s-.4-.8-.4-2c0-1.9 1.1-3.3 2.5-3.3 1.2 0 1.7.9 1.7 2s-.6 2.6-.9 4c-.3 1.1.6 2 1.7 2 2 0 3.6-2.1 3.6-5.1 0-2.7-1.9-4.6-4.7-4.6-3.2 0-5.1 2.4-5.1 4.9 0 1 .4 1.7.9 2.2.1.1.1.2.1.3-.1.4-.3 1.3-.4 1.5-.1.4-.4.5-.8.4-1.6-.7-2.6-2.9-2.6-4.7 0-3.8 2.8-7.3 8-7.3 4.2 0 7.5 3 7.5 7 0 4.2-2.6 7.5-6.3 7.5-1.2 0-2.4-.6-2.8-1.4l-.8 3c-.3 1-1.1 2.3-1.6 3.1 1.2.4 2.5.6 3.8.6 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
                  </a>
                {%- endif -%}
                {%- if section.settings.youtube_url != blank -%}
                  <a href="{{ section.settings.youtube_url }}" aria-label="YouTube" target="_blank" rel="noopener">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 8l6 4-6 4V8zm11-1.2s-.2-1.4-.8-2C18.4 4 17 4 17 4H7s-1.4 0-3.2.8C3.2 5.4 3 6.8 3 6.8S2 8.6 2 11.2v1.6c0 2.6.2 4.4.2 4.4s.2 1.4.8 2C5.6 20 7 20 7 20h10s1.4 0 3.2-.8c.6-.6.8-2 .8-2s.2-1.8.2-4.4v-1.6c0-2.6-.2-4.4-.2-4.4z"/></svg>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="gh-footer__col gh-footer__col--accordion gh-footer__col--categories">
          <button type="button" class="gh-footer__accordion-btn" data-gh-footer-accordion aria-expanded="false">
            {{ section.settings.categories_heading }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="gh-footer__col-panel">
            <h3 class="gh-footer__col-title">{{ section.settings.categories_heading }}</h3>
            <div class="gh-footer__cat-columns">
              {%- if categories_menu != blank and linklists[categories_menu].links.size > 0 -%}
                {%- assign cat_links = linklists[categories_menu].links -%}
                {%- assign cat_half = cat_links.size | plus: 1 | divided_by: 2 -%}
                <ul class="gh-footer__links" role="list">
                  {%- for link in cat_links -%}
                    {%- if forloop.index <= cat_half -%}
                      <li>
                        <a href="{{ link.url }}" class="gh-footer__cat-link">
                          <span class="gh-footer__cat-link-left">
                            {% render 'grosyhub-footer-cat-icon', title: link.title %}
                            <span>{{ link.title }}</span>
                          </span>
                          <svg class="gh-footer__cat-chevron" width="8" height="8" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 3l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                <ul class="gh-footer__links" role="list">
                  {%- for link in cat_links -%}
                    {%- if forloop.index > cat_half -%}
                      <li>
                        <a href="{{ link.url }}" class="gh-footer__cat-link">
                          <span class="gh-footer__cat-link-left">
                            {% render 'grosyhub-footer-cat-icon', title: link.title %}
                            <span>{{ link.title }}</span>
                          </span>
                          <svg class="gh-footer__cat-chevron" width="8" height="8" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 3l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- else -%}
                {%- assign category_blocks = section.blocks | where: 'type', 'category' -%}
                {%- assign cat_half = category_blocks.size | plus: 1 | divided_by: 2 -%}
                <ul class="gh-footer__links" role="list">
                  {%- for block in category_blocks -%}
                    {%- if forloop.index <= cat_half -%}
                      <li {{ block.shopify_attributes }}>
                        <a href="{{ block.settings.url | default: '#' }}" class="gh-footer__cat-link">
                          <span class="gh-footer__cat-link-left">
                            {% render 'grosyhub-mega-menu-icon', icon: block.settings.icon %}
                            <span>{{ block.settings.label }}</span>
                          </span>
                          <svg class="gh-footer__cat-chevron" width="8" height="8" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 3l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                <ul class="gh-footer__links" role="list">
                  {%- for block in category_blocks -%}
                    {%- if forloop.index > cat_half -%}
                      <li {{ block.shopify_attributes }}>
                        <a href="{{ block.settings.url | default: '#' }}" class="gh-footer__cat-link">
                          <span class="gh-footer__cat-link-left">
                            {% render 'grosyhub-mega-menu-icon', icon: block.settings.icon %}
                            <span>{{ block.settings.label }}</span>
                          </span>
                          <svg class="gh-footer__cat-chevron" width="8" height="8" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 3l4 4-4 4" stroke="currentColor" stroke-width="1.5"/></svg>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        </div>

        <div class="gh-footer__col gh-footer__col--accordion">
          <button type="button" class="gh-footer__accordion-btn" data-gh-footer-accordion aria-expanded="false">
            {{ section.settings.quick_heading }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="gh-footer__col-panel">
            <h3 class="gh-footer__col-title">{{ section.settings.quick_heading }}</h3>
            <ul class="gh-footer__links" role="list">
              {%- liquid
                assign quick_from_menu = false
                if quick_menu != blank and linklists[quick_menu].links.size > 0
                  assign quick_from_menu = true
                endif
              -%}
              {%- if quick_from_menu -%}
                {%- for link in linklists[quick_menu].links -%}
                  <li><a href="{{ link.url }}" class="gh-footer__plain-link">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'quick_link' and block.settings.label != blank -%}
                    {%- liquid
                      assign quick_href = block.settings.url | default: '#'
                      assign policy_key = block.settings.policy_link | default: 'none'
                      if policy_key != 'none' and policy_key != blank
                        case policy_key
                          when 'privacy'
                            if pages['privacy-policy'] != blank
                              assign quick_href = pages['privacy-policy'].url
                            elsif shop.policies.privacy_policy != blank
                              assign quick_href = shop.policies.privacy_policy.url
                            endif
                          when 'refund'
                            if pages['refund-policy'] != blank
                              assign quick_href = pages['refund-policy'].url
                            elsif shop.policies.refund_policy != blank
                              assign quick_href = shop.policies.refund_policy.url
                            endif
                          when 'shipping'
                            if pages['shipping-policy'] != blank
                              assign quick_href = pages['shipping-policy'].url
                            elsif shop.policies.shipping_policy != blank
                              assign quick_href = shop.policies.shipping_policy.url
                            endif
                          when 'terms'
                            if pages['terms-of-service'] != blank
                              assign quick_href = pages['terms-of-service'].url
                            elsif shop.policies.terms_of_service != blank
                              assign quick_href = shop.policies.terms_of_service.url
                            endif
                        endcase
                      endif
                    -%}
                    <li {{ block.shopify_attributes }}>
                      <a href="{{ quick_href }}" class="gh-footer__plain-link">{{ block.settings.label }}</a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        </div>

        <div class="gh-footer__col gh-footer__col--accordion">
          <button type="button" class="gh-footer__accordion-btn" data-gh-footer-accordion aria-expanded="false">
            {{ section.settings.support_heading }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="gh-footer__col-panel">
            <h3 class="gh-footer__col-title">{{ section.settings.support_heading }}</h3>
            {%- if section.settings.support_intro != blank -%}<p class="gh-footer__support-intro">{{ section.settings.support_intro }}</p>{%- endif -%}
            {%- if section.settings.support_hours != blank -%}<p class="gh-footer__support-hours">{{ section.settings.support_hours }}</p>{%- endif -%}
            <div class="gh-footer__contact-box">
              {%- if section.settings.phone != blank -%}
                <a href="tel:{{ section.settings.phone | replace: ' ', '' }}" class="gh-footer__contact-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6.6 4h2.2l1.2 5-3.1 2.1a11 11 0 005.4 5.4l2.1-3.1 5 1.2v2.2a2 2 0 01-2 1.9C12.1 18.5 5.5 11.9 4.7 6.6A2 2 0 016.6 4z" stroke="currentColor" stroke-width="1.4"/></svg>
                  <span>{{ section.settings.phone }}</span>
                </a>
              {%- endif -%}
              {%- if section.settings.email != blank -%}
                <a href="mailto:{{ section.settings.email }}" class="gh-footer__contact-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16v12H4V6zm0 0l8 7 8-7" stroke="currentColor" stroke-width="1.4"/></svg>
                  <span>{{ section.settings.email }}</span>
                </a>
              {%- endif -%}
              {%- if section.settings.chat_label != blank -%}
                <span class="gh-footer__contact-item">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v10H8l-4 4V5z" stroke="currentColor" stroke-width="1.4"/></svg>
                  <span>{{ section.settings.chat_label }}</span>
                </span>
              {%- endif -%}
            </div>
            {%- if section.settings.secure_label != blank -%}
              <div class="gh-footer__secure-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3l8 4v6c0 4.5-3.5 8.7-8 9.5C7.5 21.7 4 17.5 4 13V7l8-4z" stroke="currentColor" stroke-width="1.4"/></svg>
                {{ section.settings.secure_label }}
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>

      {%- if section.settings.show_trust_bar -%}
        <div class="gh-footer__trust-bar">
          <div class="gh-footer__trust-bar-grid">
            {%- for i in (1..4) -%}
              {%- assign bt = 'bar_title_' | append: i -%}
              {%- assign bs = 'bar_sub_' | append: i -%}
              {%- if section.settings[bt] != blank -%}
                <div class="gh-footer__trust-bar-item">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    {%- case i -%}
                      {%- when 1 -%}<path d="M1 4h15v10H6l-4 4V4zm17 2h4l2 4v8h-6V6z" stroke="currentColor" stroke-width="1.4"/>
                      {%- when 2 -%}<path d="M4 7h12l2 4v6H6l-2-4V7z" stroke="currentColor" stroke-width="1.4"/>
                      {%- when 3 -%}<path d="M12 3l7 3v5c0 4.5-3.2 8.4-7 9-3.8-.6-7-4.5-7-9V6l7-3z" stroke="currentColor" stroke-width="1.4"/>
                      {%- else -%}<path d="M12 3l2.4 4.8 5.4.8-3.9 3.8.9 5.4L12 16.8 7.2 17l.9-5.4-3.9-3.8 5.4-.8L12 3z" stroke="currentColor" stroke-width="1.4"/>
                    {%- endcase -%}
                  </svg>
                  <div>
                    <strong>{{ section.settings[bt] }}</strong>
                    {%- if section.settings[bs] != blank -%}<span>{{ section.settings[bs] }}</span>{%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="gh-footer__bottom">
    <div class="gh-container">
      <div class="gh-footer__bottom-inner">
        <p class="gh-footer__copyright">
          {%- if section.settings.copyright != blank -%}
            {{ section.settings.copyright | replace: '[year]', year }}
          {%- else -%}
            Â© {{ year }} {{ shop.name }}. All Rights Reserved.
          {%- endif -%}
        </p>
        {%- if section.settings.show_payments -%}
          <div class="gh-footer__payments">
            <p class="gh-footer__payments-label">{{ section.settings.payments_label }}</p>
            <div class="gh-footer__payment-icons" aria-hidden="true">
              <span>VISA</span>
              <span>MC</span>
              <span>UPI</span>
              <span>Paytm</span>
              <span>PhonePe</span>
            </div>
          </div>
        {%- endif -%}
        <div class="gh-footer__legal-wrap">
          <ul class="gh-footer__legal" role="list">
            {%- if shop.policies.privacy_policy -%}<li><a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a></li>{%- endif -%}
            {%- if shop.policies.terms_of_service -%}<li><a href="{{ shop.policies.terms_of_service.url }}">Terms &amp; Conditions</a></li>{%- endif -%}
            {%- if shop.policies.refund_policy -%}<li><a href="{{ shop.policies.refund_policy.url }}">Refund Policy</a></li>{%- endif -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<script src="{{ 'grosyhub-footer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Grosyhub Footer",
  "tag": "footer",
  "class": "grosyhub-footer-section",
  "settings": [
    { "type": "color", "id": "brand_color", "label": "Brand color", "default": "#b89774" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Join the Grosyhub Family" },
    { "type": "textarea", "id": "newsletter_text", "label": "Subtext", "default": "Get exclusive deals, early access to new products & special offers." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "newsletter_button", "label": "Button label", "default": "Subscribe Now" },
    { "type": "text", "id": "newsletter_success", "label": "Success message", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "No spam, unsubscribe anytime" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Exclusive offers for subscribers" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Be the first to know about new arrivals" },
    { "type": "header", "content": "Brand column" },
    { "type": "textarea", "id": "brand_description", "label": "Description", "default": "Premium home essentials designed to make everyday living easier, organized, and more beautiful." },
    { "type": "text", "id": "brand_trust_1", "label": "Trust line 1", "default": "Secure Payments" },
    { "type": "text", "id": "brand_trust_2", "label": "Trust line 2", "default": "7 Days Easy Returns" },
    { "type": "text", "id": "brand_trust_3", "label": "Trust line 3", "default": "Premium Quality" },
