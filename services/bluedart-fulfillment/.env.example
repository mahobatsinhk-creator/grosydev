# Server
PORT=8787
API_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=

# Auto fulfill: manual | webhook | batch | all
# manual = dashboard/CLI only (safest to start)
# webhook = instant AWB when order is paid
# batch = process unfulfilled on a timer (see cron below)
# all = webhook + batch timer
AUTO_FULFILL_MODE=manual
AUTO_FULFILL_CRON_MINUTES=0
AUTO_FULFILL_BATCH_LIMIT=25
AUTO_FULFILL_NOTIFY_CUSTOMER=true

# Blue Dart (production)
BLUEDART_LOGIN_ID=PLN15697
